# /etc/systemd/system/bayu-portal.service
# sudo systemctl enable --now bayu-portal.service
[Unit]
Description=Bayu Logger local settings portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adminpi4
Group=adminpi4
WorkingDirectory=/home/adminpi4/logger-portal
ExecStart=/home/adminpi4/logger-portal/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
