# Public API (read-only sensor data for third-party integrations)
# Copy to .env and fill in real values:  cp public-api/.env.example public-api/.env
# Never commit the resulting .env — it is gitignored.
#
# NOTE: when running via docker compose these are supplied by docker-compose.yml
# instead, and .env is excluded from the image by public-api/.dockerignore.

# --- Postgres ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bayu_sense
# Application role: used for the read queries this API serves.
DB_USER=app_user
DB_PASS=change-me
# Admin role: used for the account tables behind /auth/register and /auth/login.
DB_ADMIN_USER=app_admin
DB_ADMIN_PASS=change-me

# --- Auth -------------------------------------------------------------------
# Shared key checked by middleware/apiKeyAuth.js (sent as the x-api-key header).
API_KEY=change-me
# Signs and verifies the JWTs issued by /auth/login. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me
