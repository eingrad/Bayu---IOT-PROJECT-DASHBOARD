# Copy to .env on the server and fill in real values:  cp .env.example .env
# .env is gitignored — never commit it.

# ---- Cloudflare Tunnel ----------------------------------------------------
# This stack runs its own cloudflared container, matching how aqms and
# aquamind already work on this server. Create a tunnel in
#   Zero Trust -> Networks -> Tunnels -> Create a tunnel (Cloudflared)
# copy the token it shows, and add a public hostname on that tunnel:
#   Subdomain/Domain: dashboard.example.com
#   Service:          HTTP -> frontend:80
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ---- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bayu_sense

# Application roles created by server/database.sql.
DB_ADMIN_USER=app_admin
DB_ADMIN_PASS=CHANGE_ME
DB_USER=app_user
DB_USER_PASS=CHANGE_ME

# ---- Auth -----------------------------------------------------------------
# Signs every login token. Generate a fresh one:  openssl rand -base64 32
# Changing it invalidates all existing sessions.
JWT_SECRET=CHANGE_ME

# ---- Integrations ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME

MQTT_BROKER_URL=mqtts://your-cluster.hivemq.cloud:8883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

# ---- Public API -----------------------------------------------------------
# Static key checked by the x-api-key middleware.
PUBLIC_API_KEY=CHANGE_ME
# The public API runs its own register/login and issues its own tokens, so this
# is deliberately a different secret from JWT_SECRET above.
PUBLIC_API_JWT_SECRET=CHANGE_ME

# ---- Tuning ---------------------------------------------------------------
# Average incoming readings over this window before writing one DB row.
AGG_INTERVAL_MS=300000

# ---- Optional -------------------------------------------------------------
# Nothing here publishes a host port by default, which is why this stack cannot
# collide with aqms or aquamind. If you need a GUI database client, uncomment
# the ports block in docker-compose.yml under `db` and set a free port here.
# Do NOT reuse 5432 — aqms-db already publishes it on 0.0.0.0.
# DB_HOST_PORT=5434
