# Main API server (Express + Postgres + MQTT/WebSocket + reports)
# Copy to .env and fill in real values:  cp server/.env.example server/.env
# Never commit the resulting .env — it is gitignored.
#
# NOTE: when running via docker compose these are supplied by docker-compose.yml
# instead, and .env is excluded from the image by server/.dockerignore.

# --- Postgres ---------------------------------------------------------------
# Admin role: owns the schema, used for DDL/migrations.
DB_ADMIN_USER=app_admin
DB_ADMIN_PASS=change-me
# Application role: used for normal runtime queries.
DB_USER=app_user
DB_USER_PASS=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bayu_sense

# --- Auth -------------------------------------------------------------------
# Signs and verifies JWTs. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me

# --- Telegram alerts --------------------------------------------------------
# Bot token from @BotFather. Used by the /telegram/webhook endpoint.
TELEGRAM_BOT_TOKEN=

# --- ngrok (local webhook tunnelling, dev only) -----------------------------
# Used by start-webhook-ngrok.js to expose the Telegram webhook publicly.
NGROK_AUTHTOKEN=

# --- MQTT ingestion ---------------------------------------------------------
# Broker the sensor loggers publish to. mqtts:// = TLS (usually port 8883).
MQTT_BROKER_URL=mqtts://your-broker.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Aggregation tuning (optional — defaults shown) -------------------------
# Rolling window averaged for the live WebSocket feed.
LIVE_WINDOW_MS=60000
# Tumbling window averaged into one database row.
AGG_INTERVAL_MS=300000
# Fallback device UUID for gas readings that arrive without one.
DEVICE_ID=

# --- Puppeteer (optional) ---------------------------------------------------
# Set only if PDF reports should use a system Chrome instead of the bundled one.
PUPPETEER_EXECUTABLE_PATH=
